# ---------------------------------------------------------------------------
# The ONLY value the app reads from the environment. Everything else
# (endpoint, deployments, retrieval settings, rate limits, ...) is fixed in
# app/config.py.
#
#   Local dev : copy this file to `.env` and paste your key below.
#   Azure     : do NOT deploy a file. Add it as an App setting instead:
#               App Service -> Settings -> Environment variables -> App settings
#               Name:  AZURE_OPENAI_API_KEY   Value: <your key>
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=

# Optional. Restrict which browser origins may call the API (comma-separated).
# Leave unset to allow any origin.
# CORS_ALLOWED_ORIGINS=https://app.starcare.com,https://portal.starcare.com
